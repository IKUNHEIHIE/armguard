# ArmGuard Test Environment Configuration Template
# Copy this file to .env and configure with your test server details

ARMGUARD_SSH_HOST=your_server_ip_or_domain
ARMGUARD_SSH_PORT=22
ARMGUARD_SSH_USER=root
ARMGUARD_SSH_PASSWORD=your_server_password

# Optional SOCKS5 proxy configuration (useful for IPv6-only servers or corporate VPNs)
ARMGUARD_SOCKS5_HOST=127.0.0.1
ARMGUARD_SOCKS5_PORT=10808
