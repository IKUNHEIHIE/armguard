# ArmGuard Auto-Generated Nginx Virtual Host Configuration
# Domain: {{ .Domain }}
# PHP Version: {{ .PHPVersion }}

server {
    listen 80;
    listen [::]:80;
    server_name {{ .Domain }}{{ range .ExtraDomains }} {{ . }}{{ end }};
    root {{ .Path }};
    index index.html index.htm index.php;

    # ARM Architecture Memory-friendly buffer tuning
    client_body_buffer_size 128k;
    client_max_body_size 50m;
    client_header_buffer_size 1k;
    large_client_header_buffers 4 8k;

    # Logging
    access_log /var/log/nginx/{{ .Domain }}.access.log combined;
    error_log /var/log/nginx/{{ .Domain }}.error.log warn;

    {{ if eq .PHPVersion "proxy" }}
    # Reverse Proxy
    location / {
        {{ if .GRPCEnabled }}
        grpc_pass {{ .ProxyPass }};
        grpc_set_header Host $host;
        grpc_set_header X-Real-IP $remote_addr;
        grpc_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        grpc_read_timeout 300s;
        grpc_send_timeout 300s;
        {{ else }}
        proxy_pass {{ .ProxyPass }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        {{ end }}
    }
    {{ else }}
    # SPA / Static routing
    location / {
        try_files $uri $uri/ /index.html;
    }
    {{ end }}

    {{ if ne .PHPVersion "static" }}{{ if ne .PHPVersion "proxy" }}
    # PHP-FPM FastCGI Handler
    location ~ \.php$ {
        fastcgi_pass unix:/run/php/php{{ .PHPVersion }}-fpm.sock;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        include fastcgi_params;
        fastcgi_buffer_size 64k;
        fastcgi_buffers 4 64k;
    }
    {{ end }}{{ end }}

    # Security: Deny dot files
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}
